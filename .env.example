# Base de données (Neon Postgres, région Francfort recommandée)
# DATABASE_URL : utilisée par l'application (connexion pooled / PgBouncer, host "...-pooler...").
# DIRECT_URL : utilisée uniquement par `prisma migrate` (connexion directe, sans "-pooler" dans le host) —
# PgBouncer ne supporte pas les verrous consultatifs nécessaires aux migrations.
DATABASE_URL="postgresql://user:password@localhost:5432/zugchess"
DIRECT_URL="postgresql://user:password@localhost:5432/zugchess"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"

# Connexion par lien magique (e-mail)
# Si absent, les liens de connexion sont affichés dans les logs du serveur (mode dev).
RESEND_API_KEY=""
EMAIL_FROM="ZugChess <login@zugchess.app>"

# OAuth Lichess (https://lichess.org/account/oauth/app)
LICHESS_CLIENT_ID=""
LICHESS_CLIENT_SECRET=""
