// ZugChess — schéma Prisma, lots 1 (socle : auth + quotas), 3 (cache tablebase) et 4 (contenu).
// Les tables du modèle de données complet (cards, review_logs, etc.) seront ajoutées lot par lot
// (voir SPEC.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Auth.js (adapter Prisma) ---------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Compte joueur ----------------------------------------------------------

enum Role {
  player
  admin
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  // Champs métier (SPEC.md, table `users`)
  locale        String  @default("fr")
  timezone      String  @default("Europe/Paris")
  publicProfile Boolean @default(true)
  founder       Boolean @default(false)
  lichessId     String? @unique
  /// Back-office interne (hors SPEC.md : rôle "administrateur" y est scopé au contenu, pas aux
  /// comptes). Jamais modifiable depuis l'UI admin elle-même — seulement via `ADMIN_EMAILS` + seed,
  /// pour éviter qu'un admin ne puisse s'auto-élever ou élever quelqu'un d'autre par erreur.
  role          Role    @default(player)
  /// Exclu des classements publics (chantier 4, anti-triche) — ne bloque jamais le jeu lui-même,
  /// seulement sa visibilité dans les classements, miroir de `publicProfile`.
  excludedFromLeaderboards Boolean @default(false)

  accounts          Account[]
  sessions          Session[]
  settings          UserSettings?
  subscription      Subscription?
  dailyUsages       DailyUsage[]
  cards             Card[]
  reviewLogs        ReviewLog[]
  playerRating      PlayerRating?
  xpEvents          XpEvent[]
  streak            Streak?
  userAchievements  UserAchievement[]

  // --- Chantier 4 : gamification compétitive ---
  playerFamilyRatings        PlayerFamilyRating[]
  ratingEvents                RatingEvent[]
  antiCheatFlags              AntiCheatFlag[]
  rushRuns                    RushRun[]
  dailyChallengeAttempts      DailyChallengeAttempt[]
  tablebasePrecisionAttempts  TablebasePrecisionAttempt[]
  leagueProfile                LeagueProfile?
  leagueMemberships           LeagueMembership[]
  leaguePointEvents           LeaguePointEvent[]
  clubMemberships              ClubMembership[]
  friendInvitesSent            FriendInvite[]
  friendshipsAsA               Friendship[]        @relation("FriendshipA")
  friendshipsAsB               Friendship[]        @relation("FriendshipB")
  // V2 (modèle de données seul, aucune logique ni UI en chantier 4)
  duelRating                   DuelRating?
  duelChallengesAsChallenger   DuelChallenge[]      @relation("DuelChallenger")
  legendaryUnlocks             UserLegendaryUnlock[]
}

model UserSettings {
  userId              String  @id
  newPerDay           Int     @default(10)
  reviewsPerDay       Int     @default(100)
  holdMoves           Int     @default(8)
  sound               Boolean @default(true)
  emailStreakReminder Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Plan {
  free
  premium
}

enum SubscriptionStatus {
  active
  canceled
  past_due
  trialing
}

enum BillingPeriod {
  monthly
  yearly
}

model Subscription {
  userId               String              @id
  plan                 Plan                @default(free)
  status               SubscriptionStatus  @default(active)
  billingPeriod        BillingPeriod?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  founderDiscount      Boolean             @default(false)
  updatedAt            DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Compteurs des quotas gratuits pour une journée donnée (fuseau du joueur).
model DailyUsage {
  userId       String
  day          DateTime @db.Date
  newPositions Int      @default(0)
  reviews      Int      @default(0)
  explanations Int      @default(0)
  /// Runs Zug Rush démarrés ce jour (chantier 4, quota "1 Rush/jour" en gratuit).
  rushRuns     Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

// --- Juge Syzygy (lot 3) -----------------------------------------------------

/// Cache des réponses de l'API tablebase de Lichess (SPEC.md, table `tablebase_cache`), pour ne
/// pas interroger `tablebase.lichess.ovh` plus d'une fois par position normalisée (limite d'1
/// requête/s imposée par Lichess).
model TablebaseCache {
  fenNormalized String   @id
  payload       Json
  fetchedAt     DateTime @default(now())
}

// --- Contenu (lot 4) ---------------------------------------------------------

/// Camp réel (pas un rôle attaquant/défenseur) — utilisé pour `Position.userSide`.
enum Side {
  white
  black
}

/// Résultat attendu avec le meilleur jeu (SPEC.md : annonce « Blancs gagnent / Nulle / Noirs gagnent »).
enum ExpectedResult {
  white
  draw
  black
}

/// Juge chargé de cette position (SPEC.md, « Types de juge »). `stockfish` est jugé côté
/// navigateur (worker WASM) ; les trois autres sont jugés côté serveur par `JudgeService`.
enum JudgeType {
  kpk
  syzygy
  stockfish
  line
}

enum PositionStatus {
  draft
  published
  archived
}

/// Thème pédagogique (SPEC.md, « Thèmes de départ ») : famille (pions, tours, dames, pièces
/// mineures, tour contre pièce mineure, études, mats élémentaires) + sous-thème (opposition, Lucena…).
model Theme {
  id     String  @id @default(cuid())
  slug   String  @unique
  family String
  order  Int
  /// `{ fr: "...", en: "..." }`
  title  Json
  free   Boolean @default(false)
  /// Textes par défaut pour les positions générées : `{ fr: { intro, attackTitle, defendTitle, attackGoal, defendGoal }, en: {...} }`
  defaultTexts Json?

  lessons   Lesson[]
  positions Position[]
}

/// Leçon courte associée à un thème (5 à 8 écrans), rédigée en Markdown.
model Lesson {
  id      String @id @default(cuid())
  themeId String
  order   Int
  /// `{ fr: "markdown...", en: "markdown..." }`
  content Json
  free    Boolean @default(false)

  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@index([themeId])
}

/// Position jouable (SPEC.md, « Bibliothèque de positions »). `lineMoves` n'est renseigné que pour
/// `judgeType = line` (ligne de méthode) : steps sérialisés au format `MethodLineStep[]` de
/// `packages/core`. `texts` porte la consigne courte, l'intro et la conclusion par langue.
model Position {
  id              String         @id @default(cuid())
  themeId         String
  fen             String
  userSide        Side
  expectedResult  ExpectedResult
  judgeType       JudgeType
  lineMoves       Json?
  /// `{ fr: { title, intro, goal, conclusion }, en: { ... } }`
  texts           Json
  /// Origine du contenu : théorie classique, puzzle Lichess, etc. (texte libre, pas d'enum fermée).
  source          String?
  rating          Float          @default(1500)
  ratingDeviation Float          @default(350)
  free            Boolean        @default(false)
  status          PositionStatus @default(draft)
  /// true = généré par script (generate-kpk, generate-syzygy), false = curé manuellement
  generated       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  theme      Theme          @relation(fields: [themeId], references: [id])
  outLinks   PositionLink[] @relation("PositionLinkFrom")
  inLinks    PositionLink[] @relation("PositionLinkTo")
  cards      Card[]
  reviewLogs ReviewLog[]

  @@index([themeId])
  @@index([status])
}

/// Variante reliée (trait inversé, symétrie) — SPEC.md, table `position_links`.
model PositionLink {
  positionId String
  linkedId   String
  kind       String

  position Position @relation("PositionLinkFrom", fields: [positionId], references: [id], onDelete: Cascade)
  linked   Position @relation("PositionLinkTo", fields: [linkedId], references: [id], onDelete: Cascade)

  @@id([positionId, linkedId])
}

// --- Répétition espacée (lot 5) ----------------------------------------------

/// État FSRS d'une position pour un joueur (SPEC.md, table `cards`). `fsrsState` sérialise le
/// `Card` de `ts-fsrs` (stability, difficulty, due, reps, lapses, state...) tel que renvoyé par
/// `packages/core`'s `scheduleNextReview` — aucun champ FSRS individuel n'est dupliqué en colonnes
/// pour rester agnostique d'une éventuelle évolution de la librairie.
model Card {
  userId     String
  positionId String
  /// Sérialisation JSON du `Card` ts-fsrs (`FsrsCardState` de `packages/core`).
  fsrsState  Json
  /// Dupliqué hors du JSON pour permettre `WHERE due <= now()` sans extraction JSON côté requête.
  due        DateTime
  suspended  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@id([userId, positionId])
  @@index([userId, due])
}

/// Historique des révisions (SPEC.md, table `review_logs`) : une ligne par position terminée,
/// source de l'XP et des statistiques (`GET /api/me/stats`).
model ReviewLog {
  id          String   @id @default(cuid())
  userId      String
  positionId  String
  /// Note FSRS 1 à 4 (Again/Hard/Good/Easy), calculée par `rateReview` (`packages/core`).
  rating      Int
  announceOk  Boolean
  errors      Int      @default(0)
  tempoLost   Boolean  @default(false)
  durationMs  Int
  /// Coups joués au format UCI, dans l'ordre.
  moves       Json
  reviewedAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@index([positionId])
}

/// Cote Glicko-2 du joueur (SPEC.md, table `player_ratings`). Mise à jour après chaque révision.
model PlayerRating {
  userId       String    @id
  rating       Float     @default(1500)
  deviation    Float     @default(350)
  volatility   Float     @default(0.06)
  games        Int       @default(0)
  /// Pic de cote jamais atteint (chantier 4, "meilleur classement atteint").
  bestRating   Float?
  bestRatingAt DateTime?
  updatedAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Source de vérité de l'XP (SPEC.md, table `xp_events`). L'XP total est la somme des montants.
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  /// Raison lisible (ex. "review_good", "session_complete", "theme_mastered:opposition").
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Série quotidienne du joueur (SPEC.md, table `streaks`). Une seule ligne par joueur.
model Streak {
  userId   String   @id
  current  Int      @default(0)
  best     Int      @default(0)
  /// Gels disponibles (max 2).
  freezes  Int      @default(0)
  /// Dernier jour de séance terminée (fuseau horaire UTC, date seulement — le service utilise le
  /// fuseau du joueur pour le calcul).
  lastDay  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Catalogue des trophées (SPEC.md, table `achievements`). Alimenté par seed/migration.
model Achievement {
  code        String  @id
  name        Json
  description Json
  /// Condition JSON évaluée par GamificationService (ex. {"type":"streak","value":7}).
  condition   Json
  icon        String

  userAchievements UserAchievement[]
}

/// Trophées débloqués par un joueur (SPEC.md, table `user_achievements`).
model UserAchievement {
  userId      String
  code        String
  unlockedAt  DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [code], references: [code], onDelete: Cascade)

  @@id([userId, code])
  @@index([userId])
}

// --- Gamification compétitive (chantier 4) ------------------------------------

/// Cote Glicko-2 par famille de finales (`Theme.family`, chaîne libre — volontairement pas un enum
/// pour ne jamais devoir migrer si une famille est ajoutée via l'admin). Même mécanique que
/// `PlayerRating`, une ligne par (joueur, famille).
model PlayerFamilyRating {
  userId       String
  family       String
  rating       Float     @default(1500)
  deviation    Float     @default(350)
  volatility   Float     @default(0.06)
  games        Int       @default(0)
  bestRating   Float?
  bestRatingAt DateTime?
  updatedAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, family])
  @@index([family, rating])
}

/// Origine d'une variation de cote. Seule `review` est active en V1 (Rush / défi du jour /
/// précision gardent leur propre score, ne font pas bouger le Glicko — décision produit actée).
enum RatingSource {
  review
}

/// Historique des variations de cote (globale ou par famille) — source du delta animé "+8/−6
/// points" après un coup, et de la courbe de progression affichée au joueur.
model RatingEvent {
  id             String       @id @default(cuid())
  userId         String
  /// null = cote globale (`PlayerRating`), sinon valeur de `Theme.family`.
  family         String?
  source         RatingSource
  ratingBefore   Float
  ratingAfter    Float
  delta          Float
  deviationAfter Float
  positionId     String?
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, family, createdAt])
}

enum AntiCheatKind {
  abnormal_speed
  perfect_vs_tablebase
  statistical_outlier
}

enum AntiCheatStatus {
  open
  cleared
  confirmed
}

/// Signalement anti-triche (SPEC.md refonte : temps de réponse anormaux, précision parfaite
/// répétée face à la tablebase...). Revu par un admin ; `confirmed` exclut des classements publics
/// via `User.excludedFromLeaderboards`.
model AntiCheatFlag {
  id         String          @id @default(cuid())
  userId     String
  kind       AntiCheatKind
  evidence   Json
  status     AntiCheatStatus @default(open)
  reviewedBy String?
  createdAt  DateTime        @default(now())
  reviewedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

enum RushMode {
  threeMin
}

enum RushRunStatus {
  inProgress
  completed
  abandoned
}

/// Une partie de Zug Rush (SPEC.md refonte, chantier 4) : enchaîner un maximum de finales en 3
/// minutes, élimination après 3 erreurs. `seed` fixe la séquence de difficulté (reproductibilité +
/// vérification serveur, jamais calculée côté client).
model RushRun {
  id             String        @id @default(cuid())
  userId         String
  mode           RushMode      @default(threeMin)
  status         RushRunStatus @default(inProgress)
  score          Int           @default(0)
  errors         Int           @default(0)
  startedAt      DateTime      @default(now())
  endedAt        DateTime?
  seed           String
  suspiciousFlag Boolean       @default(false)
  createdAt      DateTime      @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts RushAttempt[]

  @@index([userId, mode, score])
  @@index([mode, createdAt, score])
}

/// Un coup/une position résolue pendant un run (séparé de `RushRun` pour agréger les temps de
/// réponse à travers tous les runs côté anti-triche sans désérialiser du JSON en masse).
model RushAttempt {
  id              String   @id @default(cuid())
  runId           String
  positionId      String
  order           Int
  correct         Boolean
  durationMs      Int
  moveDurationsMs Json
  createdAt       DateTime @default(now())

  run RushRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, order])
}

/// La position du défi du jour, identique pour tous les joueurs (SPEC.md refonte).
model DailyChallenge {
  id         String   @id @default(cuid())
  date       DateTime @unique @db.Date
  positionId String
  createdAt  DateTime @default(now())
}

/// Tentative d'un joueur sur le défi du jour — un seul essai par jour (décision produit actée) :
/// unique par (défi, joueur). `resultsJson` sert à régénérer la grille de partage façon Wordle sans
/// stocker la position elle-même (pas de spoiler).
model DailyChallengeAttempt {
  id               String   @id @default(cuid())
  dailyChallengeId String
  userId           String
  success          Boolean  @default(false)
  durationMs       Int
  resultsJson      Json
  completedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dailyChallengeId, userId])
  @@index([dailyChallengeId, success, durationMs])
}

enum JudgeOutcomeDb {
  win
  draw
  loss
}

/// Mode « précision contre la tablebase » (SPEC.md refonte) : compare le nombre de coups joués au
/// DTZ optimal, capturé côté serveur via le juge Syzygy déjà en place (`packages/core/judge/syzygy`).
model TablebasePrecisionAttempt {
  id           String         @id @default(cuid())
  userId       String
  positionId   String
  movesPlayed  Int
  optimalMoves Int
  precisionPct Float
  outcome      JudgeOutcomeDb
  durationMs   Int
  createdAt    DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([positionId, precisionPct])
}

/// Paliers de ligue hebdomadaire (SPEC.md refonte) : Pion → Cavalier → Fou → Tour → Dame → Roi.
enum LeagueDivision {
  pion
  cavalier
  fou
  tour
  dame
  roi
}

/// Division persistante du joueur, point de départ du rollover hebdomadaire (distincte de
/// `LeagueMembership`, qui est l'état d'UNE semaine donnée et est recréée chaque lundi).
model LeagueProfile {
  userId          String         @id
  currentDivision LeagueDivision @default(pion)
  bestDivision    LeagueDivision @default(pion)
  updatedAt       DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Une semaine de compétition de ligue (lundi → dimanche). `rolledOver` évite un double traitement
/// du cron de fin de semaine.
model LeagueSeason {
  id         String   @id @default(cuid())
  weekStart  DateTime @unique @db.Date
  weekEnd    DateTime @db.Date
  rolledOver Boolean  @default(false)
  createdAt  DateTime @default(now())

  groups      LeagueGroup[]
  memberships LeagueMembership[]
}

/// Groupe d'environ 30 joueurs de niveau proche, pour une division et une semaine données.
model LeagueGroup {
  id       String         @id @default(cuid())
  seasonId String
  division LeagueDivision
  index    Int

  season      LeagueSeason       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  memberships LeagueMembership[]

  @@unique([seasonId, division, index])
}

/// Appartenance d'un joueur à un groupe pour une semaine donnée. `points` = XP gagné dans la
/// semaine (décision produit actée : réutilise le système XP existant, pas de nouvelle formule).
model LeagueMembership {
  id        String   @id @default(cuid())
  seasonId  String
  groupId   String
  userId    String
  points    Int      @default(0)
  rank      Int?
  promoted  Boolean?
  relegated Boolean?
  joinedAt  DateTime @default(now())

  season LeagueSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  group  LeagueGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonId, userId])
  @@index([groupId, points])
}

/// Source de vérité événementielle des points de ligue, même pattern que `XpEvent`.
model LeaguePointEvent {
  id        String   @id @default(cuid())
  userId    String
  seasonId  String
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, seasonId, createdAt])
}

/// Club (SPEC.md refonte : "premier club, le Cercle d'échecs spicéen"). `name` localisé comme
/// `Theme.title`.
model Club {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      Json
  createdAt DateTime @default(now())

  memberships ClubMembership[]
}

model ClubMembership {
  clubId   String
  userId   String
  joinedAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clubId, userId])
  @@index([userId])
}

/// Lien d'invitation ami, réutilisable sans expiration en V1.
model FriendInvite {
  id        String    @id @default(cuid())
  inviterId String
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  inviter User @relation(fields: [inviterId], references: [id], onDelete: Cascade)
}

/// Relation d'amitié symétrique — `userAId` < `userBId` par convention applicative pour éviter les
/// doublons de paire.
model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA User @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
}

// --- V2 : modèle de données préparé, aucune logique/route/UI en chantier 4 ----------------------

enum DuelStatus {
  pending
  accepted
  completed
  expired
}

model DuelRating {
  userId     String   @id
  rating     Float    @default(1500)
  deviation  Float    @default(350)
  volatility Float    @default(0.06)
  games      Int      @default(0)
  updatedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DuelChallenge {
  id           String     @id @default(cuid())
  challengerId String
  opponentId   String?
  inviteToken  String     @unique
  /// Série de positions figée à la création, identique pour les deux joueurs.
  positionIds  Json
  status       DuelStatus @default(pending)
  createdAt    DateTime   @default(now())
  expiresAt    DateTime?

  challenger User @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
}

model DuelResult {
  duelChallengeId String
  userId          String
  score           Int
  accuracyPct     Float
  totalDurationMs Int
  completedAt     DateTime @default(now())

  @@id([duelChallengeId, userId])
}

model LegendaryChallenge {
  id            String @id @default(cuid())
  positionId    String
  requiredLevel Int
  title         Json

  unlocks UserLegendaryUnlock[]
}

model UserLegendaryUnlock {
  userId      String
  challengeId String
  unlockedAt  DateTime @default(now())

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge LegendaryChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@id([userId, challengeId])
}
