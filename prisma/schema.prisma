// ZugChess — schéma Prisma, lots 1 (socle : auth + quotas), 3 (cache tablebase) et 4 (contenu).
// Les tables du modèle de données complet (cards, review_logs, etc.) seront ajoutées lot par lot
// (voir SPEC.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Auth.js (adapter Prisma) ---------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Compte joueur ----------------------------------------------------------

enum Role {
  player
  admin
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  // Champs métier (SPEC.md, table `users`)
  locale        String  @default("fr")
  timezone      String  @default("Europe/Paris")
  publicProfile Boolean @default(true)
  founder       Boolean @default(false)
  lichessId     String? @unique
  /// Back-office interne (hors SPEC.md : rôle "administrateur" y est scopé au contenu, pas aux
  /// comptes). Jamais modifiable depuis l'UI admin elle-même — seulement via `ADMIN_EMAILS` + seed,
  /// pour éviter qu'un admin ne puisse s'auto-élever ou élever quelqu'un d'autre par erreur.
  role          Role    @default(player)

  accounts     Account[]
  sessions     Session[]
  settings     UserSettings?
  subscription Subscription?
  dailyUsages  DailyUsage[]
  cards        Card[]
  reviewLogs   ReviewLog[]
}

model UserSettings {
  userId              String  @id
  newPerDay           Int     @default(10)
  reviewsPerDay       Int     @default(100)
  holdMoves           Int     @default(8)
  sound               Boolean @default(true)
  emailStreakReminder Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Plan {
  free
  premium
}

enum SubscriptionStatus {
  active
  canceled
  past_due
  trialing
}

enum BillingPeriod {
  monthly
  yearly
}

model Subscription {
  userId               String              @id
  plan                 Plan                @default(free)
  status               SubscriptionStatus  @default(active)
  billingPeriod        BillingPeriod?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  founderDiscount      Boolean             @default(false)
  updatedAt            DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Compteurs des quotas gratuits pour une journée donnée (fuseau du joueur).
model DailyUsage {
  userId       String
  day          DateTime @db.Date
  newPositions Int      @default(0)
  reviews      Int      @default(0)
  explanations Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

// --- Juge Syzygy (lot 3) -----------------------------------------------------

/// Cache des réponses de l'API tablebase de Lichess (SPEC.md, table `tablebase_cache`), pour ne
/// pas interroger `tablebase.lichess.ovh` plus d'une fois par position normalisée (limite d'1
/// requête/s imposée par Lichess).
model TablebaseCache {
  fenNormalized String   @id
  payload       Json
  fetchedAt     DateTime @default(now())
}

// --- Contenu (lot 4) ---------------------------------------------------------

/// Camp réel (pas un rôle attaquant/défenseur) — utilisé pour `Position.userSide`.
enum Side {
  white
  black
}

/// Résultat attendu avec le meilleur jeu (SPEC.md : annonce « Blancs gagnent / Nulle / Noirs gagnent »).
enum ExpectedResult {
  white
  draw
  black
}

/// Juge chargé de cette position (SPEC.md, « Types de juge »). `stockfish` est jugé côté
/// navigateur (worker WASM) ; les trois autres sont jugés côté serveur par `JudgeService`.
enum JudgeType {
  kpk
  syzygy
  stockfish
  line
}

enum PositionStatus {
  draft
  published
  archived
}

/// Thème pédagogique (SPEC.md, « Thèmes de départ ») : famille (pions, tours, dames, pièces
/// mineures, tour contre pièce mineure, études, mats élémentaires) + sous-thème (opposition, Lucena…).
model Theme {
  id     String  @id @default(cuid())
  slug   String  @unique
  family String
  order  Int
  /// `{ fr: "...", en: "..." }`
  title  Json
  free   Boolean @default(false)
  /// Textes par défaut pour les positions générées : `{ fr: { intro, attackTitle, defendTitle, attackGoal, defendGoal }, en: {...} }`
  defaultTexts Json?

  lessons   Lesson[]
  positions Position[]
}

/// Leçon courte associée à un thème (5 à 8 écrans), rédigée en Markdown.
model Lesson {
  id      String @id @default(cuid())
  themeId String
  order   Int
  /// `{ fr: "markdown...", en: "markdown..." }`
  content Json
  free    Boolean @default(false)

  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@index([themeId])
}

/// Position jouable (SPEC.md, « Bibliothèque de positions »). `lineMoves` n'est renseigné que pour
/// `judgeType = line` (ligne de méthode) : steps sérialisés au format `MethodLineStep[]` de
/// `packages/core`. `texts` porte la consigne courte, l'intro et la conclusion par langue.
model Position {
  id              String         @id @default(cuid())
  themeId         String
  fen             String
  userSide        Side
  expectedResult  ExpectedResult
  judgeType       JudgeType
  lineMoves       Json?
  /// `{ fr: { title, intro, goal, conclusion }, en: { ... } }`
  texts           Json
  /// Origine du contenu : théorie classique, puzzle Lichess, etc. (texte libre, pas d'enum fermée).
  source          String?
  rating          Float          @default(1500)
  ratingDeviation Float          @default(350)
  free            Boolean        @default(false)
  status          PositionStatus @default(draft)
  /// true = généré par script (generate-kpk, generate-syzygy), false = curé manuellement
  generated       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  theme      Theme          @relation(fields: [themeId], references: [id])
  outLinks   PositionLink[] @relation("PositionLinkFrom")
  inLinks    PositionLink[] @relation("PositionLinkTo")
  cards      Card[]
  reviewLogs ReviewLog[]

  @@index([themeId])
  @@index([status])
}

/// Variante reliée (trait inversé, symétrie) — SPEC.md, table `position_links`.
model PositionLink {
  positionId String
  linkedId   String
  kind       String

  position Position @relation("PositionLinkFrom", fields: [positionId], references: [id], onDelete: Cascade)
  linked   Position @relation("PositionLinkTo", fields: [linkedId], references: [id], onDelete: Cascade)

  @@id([positionId, linkedId])
}

// --- Répétition espacée (lot 5) ----------------------------------------------

/// État FSRS d'une position pour un joueur (SPEC.md, table `cards`). `fsrsState` sérialise le
/// `Card` de `ts-fsrs` (stability, difficulty, due, reps, lapses, state...) tel que renvoyé par
/// `packages/core`'s `scheduleNextReview` — aucun champ FSRS individuel n'est dupliqué en colonnes
/// pour rester agnostique d'une éventuelle évolution de la librairie.
model Card {
  userId     String
  positionId String
  /// Sérialisation JSON du `Card` ts-fsrs (`FsrsCardState` de `packages/core`).
  fsrsState  Json
  /// Dupliqué hors du JSON pour permettre `WHERE due <= now()` sans extraction JSON côté requête.
  due        DateTime
  suspended  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@id([userId, positionId])
  @@index([userId, due])
}

/// Historique des révisions (SPEC.md, table `review_logs`) : une ligne par position terminée,
/// source de l'XP et des statistiques (`GET /api/me/stats`).
model ReviewLog {
  id          String   @id @default(cuid())
  userId      String
  positionId  String
  /// Note FSRS 1 à 4 (Again/Hard/Good/Easy), calculée par `rateReview` (`packages/core`).
  rating      Int
  announceOk  Boolean
  errors      Int      @default(0)
  tempoLost   Boolean  @default(false)
  durationMs  Int
  /// Coups joués au format UCI, dans l'ordre.
  moves       Json
  reviewedAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@index([positionId])
}
